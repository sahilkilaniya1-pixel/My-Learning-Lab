function printHollowParallelogram(rows, cols) {
  for (let i = 0; i < rows; i++) {
    let rowStr = "";
    for (let j = 0; j < rows - i - 1; j++) {
      rowStr += " ";
    }
    for (let j = 0; j < cols; j++) {
      if (i === 0 || i === rows - 1 || j === 0 || j === cols - 1) {
        rowStr += "*";
      } else {
        rowStr += " ";
      }
    }
    console.log(rowStr);
  }
}
printHollowParallelogram(5, 8);
